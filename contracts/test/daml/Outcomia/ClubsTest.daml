-- | Clubs on the market factory: roster lifecycle, club market creation gated
-- by the club policy, members-only entry and admin sync to the club factory.
module Outcomia.ClubsTest where

import Canton.MarketFactory qualified as MF
import DA.Assert ((===))
import DA.Map qualified as Map
import DA.Time (addRelTime, days)
import Daml.Script
import Splice.Api.Token.HoldingV2 qualified as H
import Outcomia.Binary
import Outcomia.Clubs
import Outcomia.CustodyTest qualified as C
import Outcomia.Factory
import Outcomia.FactoryTest qualified as FT
import Outcomia.Positions
import Outcomia.ProtocolRoles qualified as Roles
import Outcomia.TokenHarness (FactoryMode(..))
import Outcomia.Types (MarketStatus(..))

data Fixture = Fixture with
    custody : C.Fixture
    owner : Party
    bob : Party
    outsider : Party
    created : ClubCreated
  deriving (Eq, Show)

operatorOf : Fixture -> Party
operatorOf f = f.custody.asset.operator

readers : Fixture -> [Party]
readers f = [operatorOf f, f.custody.vault, f.custody.asset.issuer, f.owner, f.bob, f.outsider]

setup : Script Fixture
setup = script do
  custody <- C.setup Good
  let a = custody.asset
  owner <- allocateParty "ClubOwner"
  bob <- allocateParty "ClubBob"
  outsider <- allocateParty "ClubOutsider"
  registry <- submit [a.operator, custody.vault] do
    createCmd ClubRegistry with
      operator = a.operator; vault = custody.vault; protocolName = "outcomia"
      assets = [FactoryAsset with instrument = a.instrument; admission = a.admission]
      nextClub = 1; rules = defaultClubRules; owned = Map.empty
  created <- submit (actAs owner <> readAs a.operator) do
    exerciseCmd registry ClubRegistry_CreateClub with owner; name = "Chess club"; kind = PublicClub
  pure Fixture with custody; owner; bob; outsider; created

as : Fixture -> Party -> Commands b -> Script b
as f party = submit (actAs party <> readAs (readers f))

failsAs : Fixture -> Party -> Commands b -> Script ()
failsAs f party = submitMustFail (actAs party <> readAs (readers f))

-- | Invites and accepts a wallet; returns the updated club.
admitWallet : Fixture -> ContractId Club -> Party -> Script (ContractId Club)
admitWallet f club wallet = do
  invited <- as f f.owner do exerciseCmd club Club_Invite with inviter = f.owner; invitee = wallet
  as f wallet do exerciseCmd invited Club_Accept with invitee = wallet

clubProof : ContractId Club -> Optional MF.CreationProof
clubProof club = Some MF.CreationProof with policy = toInterfaceContractId club; evidence = []

createMarket : Fixture -> ContractId OutcomiaMarketFactory -> Party -> ContractId Club -> MF.Access -> Commands MF.MarketCreated
createMarket f factory creator club access =
  exerciseCmd (toInterfaceContractId @MF.MarketFactory factory) MF.MarketFactory_Create with
    creator; terms = FT.standardTerms f.custody.asset; access; proof = clubProof club

clubValue : Fixture -> ContractId Club -> Script Club
clubValue f cid = do
  Some value <- queryContractId (operatorOf f) cid
  pure value

test_creating_a_club_sets_up_the_roster_and_factory : Script ()
test_creating_a_club_sets_up_the_roster_and_factory = script do
  f <- setup
  let op = operatorOf f
  club <- clubValue f f.created.club
  (club.owner, club.admins, club.members) === (f.owner, [f.owner], [f.owner])
  club.marketPolicy === AdminsOnly
  club.ref.policyId === "club/1"
  Some factory <- queryContractId op f.created.factory
  factory.ref.factoryId === "club-1"
  factory.admins === [f.owner]
  factory.policy === MF.ByPolicy club.ref
  -- The owner sees the club from their own wallet.
  Some _ <- queryContractId f.owner f.created.club
  failsAs f f.outsider do
    exerciseCmd f.created.registry ClubRegistry_CreateClub with owner = f.outsider; name = " padded"; kind = PrivateClub
  second <- as f f.outsider do
    exerciseCmd f.created.registry ClubRegistry_CreateClub with owner = f.outsider; name = "Rival"; kind = PrivateClub
  rival <- clubValue f second.club
  rival.ref.policyId === "club/2"

test_invitations_accept_decline_revoke_and_expire : Script ()
test_invitations_accept_decline_revoke_and_expire = script do
  f <- setup
  failsAs f f.bob do exerciseCmd f.created.club Club_Invite with inviter = f.bob; invitee = f.outsider
  invited <- as f f.owner do exerciseCmd f.created.club Club_Invite with inviter = f.owner; invitee = f.bob
  -- The invitee sees the club; nobody else can accept for them.
  Some _ <- queryContractId f.bob invited
  failsAs f f.outsider do exerciseCmd invited Club_Accept with invitee = f.bob
  joined <- as f f.bob do exerciseCmd invited Club_Accept with invitee = f.bob
  club <- clubValue f joined
  (club.members, club.invitations) === ([f.owner, f.bob], [])
  failsAs f f.owner do exerciseCmd joined Club_Invite with inviter = f.owner; invitee = f.bob
  -- Decline and revoke.
  again <- as f f.owner do exerciseCmd joined Club_Invite with inviter = f.owner; invitee = f.outsider
  declined <- as f f.outsider do exerciseCmd again Club_Decline with invitee = f.outsider
  reinvited <- as f f.owner do exerciseCmd declined Club_Invite with inviter = f.owner; invitee = f.outsider
  failsAs f f.bob do exerciseCmd reinvited Club_RevokeInvite with actor = f.bob; invitee = f.outsider
  revoked <- as f f.owner do exerciseCmd reinvited Club_RevokeInvite with actor = f.owner; invitee = f.outsider
  failsAs f f.outsider do exerciseCmd revoked Club_Accept with invitee = f.outsider
  -- Expiry: accepting fails afterwards, and clearing needs an expired one.
  expiring <- as f f.owner do exerciseCmd revoked Club_Invite with inviter = f.owner; invitee = f.outsider
  failsAs f f.bob do exerciseCmd expiring Club_ClearExpired with closer = f.bob
  now <- getTime
  setTime (addRelTime now (days 7))
  failsAs f f.outsider do exerciseCmd expiring Club_Accept with invitee = f.outsider
  cleared <- as f f.bob do exerciseCmd expiring Club_ClearExpired with closer = f.bob
  after <- clubValue f cleared
  after.invitations === []

test_club_markets_follow_the_club_policy : Script ()
test_club_markets_follow_the_club_policy = script do
  f <- setup
  let op = operatorOf f
  club <- admitWallet f f.created.club f.bob
  value <- clubValue f club
  first <- as f f.owner do createMarket f f.created.factory f.owner club (MF.Restricted value.ref)
  first.ref.factory.factoryId === "club-1"
  Some market <- queryContractId op (fromInterfaceContractId @BinaryMarket first.market)
  market.access === Some value.ref
  let factory = fromInterfaceContractId @OutcomiaMarketFactory first.factory
  -- Bob is a member but not an admin; the outsider is not a member.
  failsAs f f.bob do createMarket f factory f.bob club MF.Public
  failsAs f f.outsider do createMarket f factory f.outsider club MF.Public
  failsAs f f.owner do
    exerciseCmd (toInterfaceContractId @MF.MarketFactory factory) MF.MarketFactory_Create with
      creator = f.owner; terms = FT.standardTerms f.custody.asset; access = MF.Public; proof = None
  -- Under the any-member policy Bob creates.
  open <- as f f.owner do exerciseCmd club Club_SetMarketPolicy with actor = f.owner; replacementPolicy = AnyMember
  second <- as f f.bob do createMarket f factory f.bob open MF.Public
  second.ref.number === 2
  -- Another club cannot stand in as this factory's policy.
  rival <- as f f.outsider do
    exerciseCmd f.created.registry ClubRegistry_CreateClub with owner = f.outsider; name = "Rival"; kind = PrivateClub
  failsAs f f.outsider do createMarket f (fromInterfaceContractId second.factory) f.outsider rival.club MF.Public

test_members_only_entry_stops_at_removal_while_exits_work : Script ()
test_members_only_entry_stops_at_removal_while_exits_work = script do
  f <- setup
  let a = f.custody.asset
  funded <- C.deposit f.custody f.custody.balance 5.0 [toInterfaceContractId @H.Holding a.input]
  club <- admitWallet f f.created.club a.alice
  value <- clubValue f club
  created <- as f f.owner do createMarket f f.created.factory f.owner club (MF.Restricted value.ref)
  let market = fromInterfaceContractId @BinaryMarket created.market
      factory = fromInterfaceContractId @OutcomiaMarketFactory created.factory
  [(reserve, _)] <- query @MarketReserve f.custody.vault
  let proof c = Some EligibilityProof with policy = toInterfaceContractId c; evidence = []
      split r b c = exerciseCmd r MarketReserve_Split with
        owner = a.alice; market; balance = b; quantity = 1; extraArgs = C.registryContext; eligibility = proof c
  failsAs f a.alice do
    exerciseCmd reserve MarketReserve_Split with
      owner = a.alice; market; balance = funded.balance; quantity = 1; extraArgs = C.registryContext; eligibility = None
  first <- as f a.alice (split reserve funded.balance club)
  removed <- as f f.owner do
    exerciseCmd club Club_RemoveMember with actor = f.owner; wallet = a.alice; factory
  failsAs f a.alice (split first.reserve first.balance removed.club)
  -- Exits never need membership: merging the pair back works.
  merged <- as f a.alice do
    exerciseCmd first.reserve MarketReserve_Merge with
      owner = a.alice; balance = first.balance; positions = [first.position]; quantity = 1
      extraArgs = C.registryContext
  Some pool <- queryContractId f.custody.vault merged.reserve
  pool.completeSets === 0

test_roles_sync_to_the_club_factory : Script ()
test_roles_sync_to_the_club_factory = script do
  f <- setup
  let op = operatorOf f
  club <- admitWallet f f.created.club f.bob
  failsAs f f.bob do
    exerciseCmd club Club_SetAdmin with wallet = f.bob; makeAdmin = True; factory = f.created.factory
  failsAs f f.owner do
    exerciseCmd club Club_SetAdmin with wallet = f.outsider; makeAdmin = True; factory = f.created.factory
  promoted <- as f f.owner do
    exerciseCmd club Club_SetAdmin with wallet = f.bob; makeAdmin = True; factory = f.created.factory
  value <- clubValue f promoted.club
  value.admins === [f.owner, f.bob]
  Some factory <- queryContractId op promoted.factory
  factory.admins === [f.owner, f.bob]
  -- A promoted admin creates and manages club markets through the factory.
  created <- as f f.bob do createMarket f promoted.factory f.bob promoted.club MF.Public
  let current = fromInterfaceContractId @OutcomiaMarketFactory created.factory
  closed <- as f f.bob do
    exerciseCmd (fromInterfaceContractId @BinaryMarket created.market) Binary_FactoryClose with
      actor = f.bob; roles = toInterfaceContractId @Roles.ProtocolRoles current; reason = "Club decision"
  Some market <- queryContractId op closed
  market.status === Closed
  -- Admins cannot remove the owner or another admin; the owner removes the admin.
  failsAs f f.bob do
    exerciseCmd promoted.club Club_RemoveMember with actor = f.bob; wallet = f.owner; factory = current
  removed <- as f f.owner do
    exerciseCmd promoted.club Club_RemoveMember with actor = f.owner; wallet = f.bob; factory = current
  Some after <- queryContractId op removed.factory
  after.admins === [f.owner]
  -- The owner cannot leave; a plain member can.
  failsAs f f.owner do
    exerciseCmd removed.club Club_Leave with wallet = f.owner; factory = removed.factory
  rejoined <- admitWallet f removed.club f.bob
  left <- as f f.bob do exerciseCmd rejoined Club_Leave with wallet = f.bob; factory = removed.factory
  final <- clubValue f left.club
  final.members === [f.owner]

test_ownership_moves_only_when_the_nominee_accepts : Script ()
test_ownership_moves_only_when_the_nominee_accepts = script do
  f <- setup
  let op = operatorOf f
  club <- admitWallet f f.created.club f.bob
  failsAs f f.owner do exerciseCmd club Club_Nominate with nominee = Some f.outsider
  nominated <- as f f.owner do exerciseCmd club Club_Nominate with nominee = Some f.bob
  failsAs f f.outsider do exerciseCmd nominated Club_AcceptOwnership with factory = f.created.factory
  -- Ownership moves only through the registry, which keeps owned-club counts.
  failsAs f f.bob do exerciseCmd nominated Club_AcceptOwnership with factory = f.created.factory
  failsAs f f.outsider do
    exerciseCmd f.created.registry ClubRegistry_AcceptOwnership with
      nominee = f.outsider; club = nominated; factory = f.created.factory
  (registry, transferred) <- as f f.bob do
    exerciseCmd f.created.registry ClubRegistry_AcceptOwnership with
      nominee = f.bob; club = nominated; factory = f.created.factory
  Some counts <- queryContractId op registry
  counts.owned === Map.fromList [(f.bob, 1)]
  value <- clubValue f transferred.club
  (value.owner, value.admins, value.pendingOwner) === (f.bob, [f.owner, f.bob], None)
  Some factory <- queryContractId op transferred.factory
  factory.admins === [f.owner, f.bob]
  left <- as f f.owner do exerciseCmd transferred.club Club_Leave with wallet = f.owner; factory = transferred.factory
  after <- clubValue f left.club
  (after.members, after.admins) === ([f.bob], [f.bob])
