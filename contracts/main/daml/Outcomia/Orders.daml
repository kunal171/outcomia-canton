-- | Fully funded orders, owner cancellation and one-pair atomic settlement.
-- An operator submits matching; signed orders delegate only the checked trade.
-- A buy owns separate cash backing; a sell owns outcome quantities removed from
-- position lots. Neither can also be spent through the owner's available state.
--
-- The bounded market index commits acceptance sequence and references. The
-- matcher recomputes best-price/FIFO from fetched contracts inside settlement;
-- an off-ledger candidate never authorizes a fill. Vault/registry custody assumptions still apply.
module Outcomia.Orders where

import DA.List (unique, sortOn)
import DA.Numeric qualified as Numeric
import Splice.Api.Token.HoldingV2 qualified as H
import Splice.Api.Token.TransferInstructionV2 qualified as T
import Splice.Api.Token.MetadataV1 (ExtraArgs)
import Outcomia.Assets (AssetAdmission(..), holdingTotal)
import Outcomia.Fees qualified as Fees
import Outcomia.MarketFees qualified as MarketFees
import Outcomia.Binary
import Outcomia.Custody
import Outcomia.Positions
import Outcomia.Matching qualified as Matching
import Outcomia.Types
import Outcomia.Validation (boundedText, termsErrors)

-- | A buy's exact trade-and-fee holding or a sell's quantity of its selected
-- outcome. Sell backing is represented directly in the signed order, not by a
-- reusable reference to an unlocked position lot.
data OrderBacking = CashEscrow (ContractId H.Holding) | OutcomeEscrow
  deriving (Eq, Show)

data OrderReference = OrderReference with
    orderId : Int
    order : ContractId LimitOrder
    outcome : Outcome
    side : OrderSide
    price : Decimal
  deriving (Eq, Show)

data PlacementResult = PlacementResult with
    book : ContractId OrderBook
    order : ContractId LimitOrder
    balance : Optional (ContractId AssetBalance)
    remainder : Optional (ContractId PositionLot)
  deriving (Eq, Show)

-- | Fee withdrawal replaces the book revision and returns real wallet cash.
data FeeWithdrawalResult = FeeWithdrawalResult with
    book : ContractId OrderBook
    walletHoldings : [ContractId H.Holding]
  deriving (Eq, Show)

data ReleasedBacking = ReleasedBacking with
    balance : Optional (ContractId AssetBalance)
    position : Optional (ContractId PositionLot)
  deriving (Eq, Show)

data CancellationResult = CancellationResult with
    book : ContractId OrderBook
    released : ReleasedBacking
  deriving (Eq, Show)

-- | A successful match returns all revised IDs. For a fill, balances are buyer
-- then seller and position belongs to the buyer. For self-trade cancellation,
-- balances contains the one owner's account and position is any restored sell
-- quantity. The decision distinguishes these cases; only fills have a receipt.
data SettlementResult = SettlementResult with
    book : ContractId OrderBook
    decision : Matching.MatchDecision
    balances : [ContractId AssetBalance]
    position : Optional (ContractId PositionLot)
    receipt : Optional (ContractId TradeFill)
  deriving (Eq, Show)

-- | An audit record, never spendable backing. Contract ID identifies the fill;
-- partial fills may share acceptance IDs. Operators can archive receipts, but
-- archival does not reverse a trade. History/indexing must retain ledger events.
template TradeFill
  with
    key : MarketKey
    vault : Party
    buyer : Party
    seller : Party
    instrument : CollateralInstrument
    plan : Matching.FillPlan
    executedAt : Time
    feeTerms : Fees.FeeTerms
    feeAmount : Decimal
    buyerRefund : Decimal
    remainingBuyEscrow : Decimal
  where
    signatory key.operator, vault
    observer buyer, seller
    ensure key.operator /= vault && buyer /= seller && buyer /= vault && seller /= vault &&
      key.marketId > 0 && boundedText 64 key.protocolName && boundedText 128 instrument.id &&
      plan.buyId > 0 && plan.sellId > 0 && plan.buyId /= plan.sellId &&
      plan.makerId == min plan.buyId plan.sellId && plan.takerId == max plan.buyId plan.sellId &&
      plan.quantity > 0 && plan.price > 0.0 && plan.price < 1.0 &&
      plan.sellerProceeds == plan.price * intToDecimal plan.quantity &&
      plan.buyerRefund >= 0.0 && plan.buyerEscrowRemaining >= 0.0 &&
      plan.buyerRemaining >= 0 && plan.sellerRemaining >= 0 &&
      feeTerms.takerFeeBps >= 0 && feeTerms.takerFeeBps <= 1000 &&
      feeTerms.assetDecimals >= 0 && feeTerms.assetDecimals <= 10 &&
      feeAmount >= 0.0 && feeAmount <= plan.sellerProceeds && buyerRefund >= 0.0 && remainingBuyEscrow >= 0.0

-- | One configured order-registry lineage, separate from account/reserve roots.
-- Joint operator/vault signers can bootstrap another root, so services must pin
-- this root too. The 1,024-ID index bounds initialization work and contract size.
template OrderRegistry
  with
    operator : Party
    vault : Party
    protocolName : Text
    marketIds : [Int]
  where
    signatory operator, vault
    ensure operator /= vault && boundedText 64 protocolName &&
      length marketIds <= 1024 && unique marketIds && all (> 0) marketIds

    -- | Inputs: active creator, current protocol/market, reserve and vetted admission.
    -- Rejects: revoked/non-creator, foreign asset/factory/reserve/namespace,
    -- tick/lot precision mismatch, changed terms,
    -- expired/Closed market or duplicate/full registration. Result: empty book
    -- with sequence 1 and a new registry revision; no collateral is moved.
    choice OrderRegistry_CreateBook : (ContractId OrderRegistry, ContractId OrderBook)
      with
        creator : Party
        protocol : ContractId Protocol
        market : ContractId BinaryMarket
        reserve : ContractId MarketReserve
        admission : ContractId AssetAdmission
      controller creator
      do
        pool <- fetch reserve
        asset <- fetch admission
        assertMsg "Book admission does not match reserve asset/factory"
          (asset.operator == operator && asset.instrument == pool.terms.collateral && asset.factory == pool.factory && asset.assetDecimals == pool.assetDecimals)
        -- Whole-contract lots and ticks must produce registry-transferable cash.
        -- For a 2-decimal asset, tick 0.001 and lot 1 would create unpayable fills.
        let lotNotional = pool.terms.priceTick * intToDecimal pool.terms.quantityLot
        assertMsg "Price tick times quantity lot must align to asset precision"
          (lotNotional > 0.0 && Numeric.roundNumeric asset.assetDecimals Numeric.RoundingDown lotNotional == lotNotional)
        assertMsg "Reserve does not belong to order registry/creator"
          (pool.key.operator == operator && pool.key.protocolName == protocolName &&
           pool.vault == vault && pool.creator == creator)
        checkCreator protocol operator protocolName creator
        current <- fetch market
        assertMsg "Market does not match the registered reserve"
          (current.operator == operator && current.protocolName == protocolName &&
           current.marketId == pool.key.marketId && current.creator == creator &&
           current.createdAt == pool.createdAt && current.terms == pool.terms)
        now <- getTime
        assertMsg "Book requires an unexpired Draft or Open market"
          (current.status /= Closed && now < current.terms.closeAt)
        assertMsg "Order book already registered" (not (current.marketId `elem` marketIds))
        assertMsg "Order registry is full" (length marketIds < 1024)
        next <- create this with marketIds = current.marketId :: marketIds
        book <- create OrderBook with
          key = pool.key; vault; creator
          terms = pool.terms
          marketCreatedAt = pool.createdAt
          factory = pool.factory
          assetDecimals = asset.assetDecimals
          nextOrderId = 1
          orders = []
          fees = MarketFees.FeePoolState 0.0 None
        pure (next, book)

-- | One bounded committed index per market, covering YES/NO and both sides.
-- Placement/cancellation consume this revision. Independent markets do not
-- contend, but requests on the same market must reload/retry stale IDs.
template OrderBook
  with
    key : MarketKey
    vault : Party
    creator : Party
    terms : BinaryTerms
    marketCreatedAt : Time
    factory : ContractId T.TransferFactory
    assetDecimals : Int
    nextOrderId : Int
    orders : [OrderReference]
    fees : MarketFees.FeePoolState
  where
    signatory key.operator, vault
    observer creator
    ensure key.operator /= vault && key.marketId > 0 && boundedText 64 key.protocolName &&
      null (termsErrors creator marketCreatedAt terms) && nextOrderId > 0 &&
      assetDecimals >= 0 && assetDecimals <= 10 &&
      Numeric.roundNumeric assetDecimals Numeric.RoundingDown (terms.priceTick * intToDecimal terms.quantityLot) == terms.priceTick * intToDecimal terms.quantityLot &&
      MarketFees.validPool assetDecimals fees &&
      length orders <= 128 && unique (map (\r -> r.orderId) orders) &&
      unique (map (\r -> r.order) orders) &&
      all (\r -> r.orderId > 0 && r.orderId < nextOrderId && validPrice terms.priceTick r.price) orders

    -- | Inputs: positive fee amount and registry context, authorized by operator.
    -- Errors: another caller, excess/off-quantum amount, stale backing or faulty
    -- registry. Result: operator-wallet tokens and a book with the remaining
    -- pool. Works after closure/cutoff; never debits trader or reserve holdings.
    choice OrderBook_WithdrawFees : FeeWithdrawalResult
      with
        amount : Decimal
        extraArgs : ExtraArgs
      controller key.operator
      do
        moved <- MarketFees.withdrawFees key.operator vault terms.collateral factory assetDecimals fees amount extraArgs
        next <- create this with fees = moved.pool
        pure FeeWithdrawalResult with book = next; walletHoldings = moved.walletHoldings

    -- | Inputs: owner, current Open market, enrolled account, outcome, price,
    -- quantity, approved fee revision/terms and registry context. Rejects stale
    -- fee quotes, cutoff, off-tick/lot values,
    -- foreign/insufficient account, capacity or sequence exhaustion.
    -- Result: trade plus maximum fee escrow, account successor and new book.
    -- Example: 3 YES at 0.40 and 25 bps locks 1.203 collateral.
    choice OrderBook_PlaceBuy : PlacementResult
      with
        owner : Party
        market : ContractId BinaryMarket
        balance : ContractId AssetBalance
        outcome : Outcome
        price : Decimal
        quantity : Int
        feePolicy : ContractId Protocol
        expectedFeeRevision : Int
        expectedFeeTerms : Fees.FeeTerms
        extraArgs : ExtraArgs
      controller owner
      do
        checkPlacement this market price quantity
        feeTerms <- checkFeeQuote this feePolicy expectedFeeRevision expectedFeeTerms
        checkOrderAccount key vault terms.collateral factory owner balance
        funding <- checkedFee (Fees.buyFunding feeTerms (Fees.BuyFeeState quantity quantity price 0.0 0.0))
        partition <- exercise balance AssetBalance_Repartition with
          otherCash = None; otherAmount = 0.0; delta = negate funding.totalEscrow; extraArgs
        cash <- case partition.otherCash of Some cid -> pure cid; None -> abort "Buy order must have cash backing"
        now <- getTime
        order <- create LimitOrder with
          key; vault; owner; factory; outcome; price; quantity
          feeTerms; feeRevision = expectedFeeRevision
          originalQuantity = quantity; takerNotional = 0.0; paidFee = 0.0
          instrument = terms.collateral
          side = Buy
          orderId = nextOrderId
          acceptedAt = now
          backing = CashEscrow cash
        next <- create this with
          nextOrderId = nextOrderId + 1
          orders = orders ++ [OrderReference nextOrderId order outcome Buy price]
        pure PlacementResult with book = next; order; balance = Some partition.balance; remainder = None

    -- | Inputs: owner, current market, 1..16 lots, order terms and fee quote.
    -- Rejects: stale fee quote, invalid market/price/quantity,
    -- wrong owner/market/vault or shortage
    -- of the selected outcome. Result: exactly quantity contracts in escrow;
    -- all other quantities remain in a successor lot. Reserve backing is unchanged.
    choice OrderBook_PlaceSell : PlacementResult
      with
        owner : Party
        market : ContractId BinaryMarket
        positions : [ContractId PositionLot]
        outcome : Outcome
        price : Decimal
        quantity : Int
        feePolicy : ContractId Protocol
        expectedFeeRevision : Int
        expectedFeeTerms : Fees.FeeTerms
      controller owner
      do
        checkPlacement this market price quantity
        feeTerms <- checkFeeQuote this feePolicy expectedFeeRevision expectedFeeTerms
        assertMsg "Sell requires 1 to 16 unique position lots"
          (not (null positions) && length positions <= 16 && unique positions)
        lots <- mapA (\cid -> do
          lot <- fetch cid
          assertMsg "Sell position owner, market or vault does not match"
            (lot.owner == owner && lot.key == key && lot.vault == vault)
          exercise cid Archive
          pure lot) positions
        let yes = sum (map (\lot -> lot.yes) lots)
        let no = sum (map (\lot -> lot.no) lots)
        let selected = if outcome == Yes then yes else no
        assertMsg "Insufficient outcome contracts for sell" (selected >= quantity)
        let remainingYes = yes - (if outcome == Yes then quantity else 0)
        let remainingNo = no - (if outcome == No then quantity else 0)
        remainder <- createRemainder key vault owner remainingYes remainingNo
        now <- getTime
        order <- create LimitOrder with
          key; vault; owner; factory; outcome; price; quantity
          feeTerms; feeRevision = expectedFeeRevision
          originalQuantity = quantity; takerNotional = 0.0; paidFee = 0.0
          instrument = terms.collateral
          side = Sell
          orderId = nextOrderId
          acceptedAt = now
          backing = OutcomeEscrow
        next <- create this with
          nextOrderId = nextOrderId + 1
          orders = orders ++ [OrderReference nextOrderId order outcome Sell price]
        pure PlacementResult with book = next; order; balance = None; remainder

    -- | Inputs: current market, selected outcome, both current owner accounts
    -- and registry context. Rejects closed/cutoff markets, absent crossings,
    -- stale contracts, wrong accounts or registry failure. Result: exactly one
    -- fill or cancel-newer self-trade action and the successor book. No fresh
    -- trader signatures are needed; nested signed orders supply their authority.
    -- This is nonconsuming only at the entry: the inner settlement MUST archive
    -- this exact book. This lets inner checks fetch its committed references.
    nonconsuming choice OrderBook_MatchBest : SettlementResult
      with
        market : ContractId BinaryMarket
        outcome : Outcome
        buyerBalance : ContractId AssetBalance
        sellerBalance : ContractId AssetBalance
        extraArgs : ExtraArgs
      controller key.operator
      do
        checkTrading this market
        buyRef <- requireBest orders outcome Buy
        sellRef <- requireBest orders outcome Sell
        buy <- fetch buyRef.order
        sell <- fetch sellRef.order
        if buy.owner == sell.owner then do
          assertMsg "Self-trade cancellation uses one owner account" (buyerBalance == sellerBalance)
          let newer = if buyRef.orderId > sellRef.orderId then buyRef.order else sellRef.order
          exercise newer LimitOrder_CancelSelfTrade with book = self; market; outcome; balance = buyerBalance; extraArgs
        else exercise buyRef.order LimitOrder_SettleBuy with
          book = self; market; sellOrder = sellRef.order; buyerBalance; sellerBalance; extraArgs

    -- | Inputs: owner, exact active order reference, optional buy refund account
    -- and registry context. Rejects: foreign/unindexed order, another owner or
    -- wrong refund account. Result: order archived, index entry removed, backing
    -- restored. No live market, admin or admission is required for cancellation.
    choice OrderBook_Cancel : CancellationResult
      with
        owner : Party
        order : ContractId LimitOrder
        balance : Optional (ContractId AssetBalance)
        extraArgs : ExtraArgs
      controller owner
      do
        current <- fetch order
        let reference = OrderReference current.orderId order current.outcome current.side current.price
        assertMsg "Order does not belong to this book or owner"
          (current.key == key && current.vault == vault && current.owner == owner &&
           current.instrument == terms.collateral && current.factory == factory && reference `elem` orders)
        released <- exercise order LimitOrder_Release with balance; extraArgs
        next <- create this with orders = filter (\r -> r.order /= order) orders
        pure CancellationResult with book = next; released

-- | Active order and exclusive escrow. Settlement choices require operator
-- and vault authority obtained through the book, then the signed buy delegates
-- its buyer into the signed sell. Neither trader can execute these internals
-- alone. Every successful settlement consumes the book and affected orders.
template LimitOrder
  with
    key : MarketKey
    vault : Party
    owner : Party
    instrument : CollateralInstrument
    factory : ContractId T.TransferFactory
    outcome : Outcome
    side : OrderSide
    price : Decimal
    quantity : Int
    feeTerms : Fees.FeeTerms
    feeRevision : Int
    originalQuantity : Int
    takerNotional : Decimal
    paidFee : Decimal
    orderId : Int
    acceptedAt : Time
    backing : OrderBacking
  where
    signatory vault, owner
    observer key.operator
    ensure vault /= key.operator && owner /= vault && key.marketId > 0 &&
      boundedText 64 key.protocolName && boundedText 128 instrument.id &&
      price > 0.0 && price < 1.0 && quantity > 0 && orderId > 0 &&
      feeRevision >= 0 && feeTerms.takerFeeBps >= 0 && feeTerms.takerFeeBps <= 1000 &&
      feeTerms.assetDecimals >= 0 && feeTerms.assetDecimals <= 10 &&
      validOrderFeeHistory this &&
      (case (side, backing) of (Buy, CashEscrow _) -> True; (Sell, OutcomeEscrow) -> True; _ -> False)

    -- | Inputs: current book/market, selected sell and owner account IDs.
    -- Rejects a non-buy or invalid settlement downstream. Result: the complete
    -- atomic trade. Nonconsuming keeps this buy fetchable during the sell's
    -- verification; the sell's body explicitly archives it. Its owner becomes
    -- an explicit controller of the nested sell, not an arbitrary free signer.
    nonconsuming choice LimitOrder_SettleBuy : SettlementResult
      with
        book : ContractId OrderBook
        market : ContractId BinaryMarket
        sellOrder : ContractId LimitOrder
        buyerBalance : ContractId AssetBalance
        sellerBalance : ContractId AssetBalance
        extraArgs : ExtraArgs
      controller key.operator, vault
      do
        assertMsg "Settlement entry requires a buy" (side == Buy)
        exercise sellOrder LimitOrder_SettleSell with
          buyer = owner; buyOrder = self; book; market; buyerBalance; sellerBalance; extraArgs

    -- | Inputs: buyer identity delegated by the signed buy, live buy/book/market
    -- and both accounts. Rejects non-best/foreign/self pairs, wrong backing,
    -- bad account bindings or registry outputs. Result: both orders and the old
    -- book consumed, exact credits, buyer position, partial-order successors and
    -- a fill receipt. Postconsuming keeps this sell visible in the full snapshot
    -- until its body finishes. All failures roll back ALL nested transfers.
    postconsuming choice LimitOrder_SettleSell : SettlementResult
      with
        buyer : Party
        buyOrder : ContractId LimitOrder
        book : ContractId OrderBook
        market : ContractId BinaryMarket
        buyerBalance : ContractId AssetBalance
        sellerBalance : ContractId AssetBalance
        extraArgs : ExtraArgs
      controller key.operator, vault, buyer
      do
        index <- fetch book
        checkTrading index market
        snapshot <- matchingSnapshot index
        buy <- fetch buyOrder
        assertMsg "Settlement buyer identity does not match its signed order" (buy.owner == buyer)
        plan <- case Matching.planFill index.terms.priceTick index.terms.quantityLot outcome snapshot of
          Right (Matching.Fill value) -> pure value
          _ -> abort "No eligible crossed pair for settlement"
        buyRef <- requireBest index.orders outcome Buy
        sellRef <- requireBest index.orders outcome Sell
        assertMsg "Settlement must use the best indexed buy and sell"
          (buyRef.order == buyOrder && sellRef.order == self && side == Sell &&
           buy.side == Buy && buy.orderId == plan.buyId && orderId == plan.sellId &&
           key == index.key && vault == index.vault && buyer /= owner)
        checkOrderAccount key vault instrument factory buyer buyerBalance
        checkOrderAccount key vault instrument factory owner sellerBalance
        cash <- case buy.backing of CashEscrow cid -> pure cid; _ -> abort "Buy must have cash escrow"
        funding <- checkedFee (Fees.buyFunding buy.feeTerms (buyFeeState buy))
        buyMovement <- checkedFee (Fees.buyFillFunding buy.feeTerms (buyFeeState buy)
          plan.price plan.quantity (plan.takerId == buy.orderId))
        sellMovement <- checkedFee (Fees.sellFillFunding feeTerms takerNotional paidFee
          plan.sellerProceeds (plan.takerId == orderId))
        assertMsg "Fee movement must agree with the verified fill gross"
          (buyMovement.tradeCost == plan.sellerProceeds &&
           sellMovement.netProceeds + sellMovement.accrual.charge == plan.sellerProceeds)
        let feeAmount = buyMovement.feeCharged + sellMovement.accrual.charge
        let takerTerms = if plan.takerId == buy.orderId then buy.feeTerms else feeTerms
        let originalCash = funding.totalEscrow
        total <- holdingTotal (H.InstrumentId instrument.admin instrument.id) (H.Account (Some vault) None "") [cash]
        assertMsg "Buy escrow amount is incorrect" (total == originalCash)
        -- Seller's account consumes the buy escrow AND its own backing. Its
        -- available credit rises only by proceeds; all change still belongs to
        -- this buy. Example: 3.00 escrow minus 1.20 proceeds leaves 1.80.
        -- A rounding carry can make a tiny seller's entire gross become fee.
        -- Custody rejects zero transfers, so preserve that account ID unchanged.
        (nextSellerBalance, afterSellerCash) <- if sellMovement.netProceeds > 0.0 then do
          paid <- exercise sellerBalance AssetBalance_Repartition with
            otherCash = Some cash; otherAmount = originalCash; delta = sellMovement.netProceeds; extraArgs
          pure (paid.balance, paid.otherCash)
          else pure (sellerBalance, Some cash)
        let afterPayment = originalCash - sellMovement.netProceeds
        collected <- MarketFees.collectFees vault instrument factory index.assetDecimals index.fees
          feeAmount afterSellerCash afterPayment extraArgs
        let afterFees = afterPayment - feeAmount
        (nextBuyerBalance, remainingCash) <- if buyMovement.refund > 0.0 then do
          refunded <- exercise buyerBalance AssetBalance_Repartition with
            otherCash = collected.remainingCash; otherAmount = afterFees; delta = buyMovement.refund; extraArgs
          pure (refunded.balance, refunded.otherCash)
          else pure (buyerBalance, collected.remainingCash)
        left <- holdingTotal (H.InstrumentId instrument.admin instrument.id) (H.Account (Some vault) None "") (optionalHoldings remainingCash)
        assertMsg "Remaining buy escrow is incorrect" (left == buyMovement.funding.totalEscrow)
        -- The inner sell has buyer authority as an explicit controller and
        -- seller authority from this signed contract. Free balances are only
        -- credited. Both outcome delivery and partial orders use those owners.
        position <- createRemainder key vault buyer
          (if outcome == Yes then plan.quantity else 0) (if outcome == No then plan.quantity else 0)
        exercise buyOrder Archive
        buyRemainder <- if plan.buyerRemaining == 0 then do
          assertMsg "Completed buy must have no remaining escrow" (remainingCash == None)
          pure None
          else do
            backingCash <- case remainingCash of Some cid -> pure cid; None -> abort "Partial buy requires escrow"
            cid <- create buy with
              quantity = plan.buyerRemaining; backing = CashEscrow backingCash
              takerNotional = buyMovement.nextState.takerNotional
              paidFee = buyMovement.nextState.paidFee
            pure (Some cid)
        sellRemainder <- if plan.sellerRemaining == 0 then pure None else do
          cid <- create this with
            quantity = plan.sellerRemaining
            takerNotional = sellMovement.accrual.takerNotional
            paidFee = sellMovement.accrual.paidFee
          pure (Some cid)
        refs <- mapA referenceFor (optionalHoldings buyRemainder ++ optionalHoldings sellRemainder)
        exercise book Archive
        next <- create index with
          orders = filter (\r -> r.order /= buyOrder && r.order /= self) index.orders ++ refs
          fees = collected.pool
        now <- getTime
        receipt <- create TradeFill with
          key; vault; buyer; instrument; plan; executedAt = now; seller = owner
          feeTerms = takerTerms; feeAmount; buyerRefund = buyMovement.refund
          remainingBuyEscrow = buyMovement.funding.totalEscrow
        pure SettlementResult with
          book = next; decision = Matching.Fill plan
          balances = [nextBuyerBalance, nextSellerBalance]; position; receipt = Some receipt

    -- | Inputs: live book/market, outcome and the one owner's refund account.
    -- Rejects anything except the recomputed newer self-cross. Result: escrow
    -- fully restored and that reference removed, with no fill receipt. Keeping
    -- the order live until the end allows validation against the whole index.
    postconsuming choice LimitOrder_CancelSelfTrade : SettlementResult
      with
        book : ContractId OrderBook
        market : ContractId BinaryMarket
        outcome : Outcome
        balance : ContractId AssetBalance
        extraArgs : ExtraArgs
      controller key.operator, vault
      do
        index <- fetch book
        checkTrading index market
        snapshot <- matchingSnapshot index
        decision <- case Matching.planFill index.terms.priceTick index.terms.quantityLot outcome snapshot of
          Right value@(Matching.CancelSelfTrade newer) | newer == orderId -> pure value
          _ -> abort "Only the newer best self-cross may be cancelled"
        assertMsg "Self-trade order must be indexed" (any (\r -> r.order == self) index.orders)
        checkOrderAccount key vault instrument factory owner balance
        released <- releaseBacking this (if side == Buy then Some balance else None) extraArgs
        exercise book Archive
        next <- create index with orders = filter (\r -> r.order /= self) index.orders
        pure SettlementResult with
          book = next; decision; position = released.position; receipt = None
          balances = [case released.balance of Some cid -> cid; None -> balance]

    -- | Inputs: buy refund account (None for a sell), registry context.
    -- Rejects: missing/wrong account, unexpected sell account, invalid backing
    -- or missing owner/vault authority. Result: exact collateral refund or a
    -- restored outcome lot. Registry failure rolls back the enclosing cancellation.
    choice LimitOrder_Release : ReleasedBacking
      with
        balance : Optional (ContractId AssetBalance)
        extraArgs : ExtraArgs
      controller owner, vault
      do
        releaseBacking this balance extraArgs

-- | Inputs: signed order state, optional owner refund account and registry
-- context. Rejects invalid backing or refund account. Result: exact release;
-- caller MUST also consume the order and update the committed book atomically.
releaseBacking : LimitOrder -> Optional (ContractId AssetBalance) -> ExtraArgs -> Update ReleasedBacking
releaseBacking order balance extraArgs = do
  case order.backing of
    CashEscrow cash -> do
      account <- case balance of Some cid -> pure cid; None -> abort "Buy cancellation requires its owner's account"
      checkOrderAccount order.key order.vault order.instrument order.factory order.owner account
      funding <- checkedFee (Fees.buyFunding order.feeTerms (buyFeeState order))
      let amount = funding.totalEscrow
      total <- holdingTotal (H.InstrumentId order.instrument.admin order.instrument.id) (H.Account (Some order.vault) None "") [cash]
      assertMsg "Buy escrow amount is incorrect" (total == amount)
      partition <- exercise account AssetBalance_Repartition with
        otherCash = Some cash; otherAmount = amount; delta = amount; extraArgs
      assertMsg "Cancelled buy must release all escrow" (partition.otherCash == None)
      pure ReleasedBacking with balance = Some partition.balance; position = None
    OutcomeEscrow -> do
      assertMsg "Sell cancellation does not take a cash account" (balance == None)
      position <- createRemainder order.key order.vault order.owner
        (if order.outcome == Yes then order.quantity else 0) (if order.outcome == No then order.quantity else 0)
      pure ReleasedBacking with balance = None; position


-- | Inputs: signed book, current market and proposed order terms. Rejects stale
-- lifecycle IDs, altered terms, closed/cutoff markets, off-tick/lot values or
-- exhausted bounds. Result: validated placement; no assets moved by this helper.
checkPlacement : OrderBook -> ContractId BinaryMarket -> Decimal -> Int -> Update ()
checkPlacement book market price quantity = do
  checkTrading book market
  assertMsg "Price must lie strictly between 0 and 1 and follow the market tick" (validPrice book.terms.priceTick price)
  checkQuantity book.terms.quantityLot quantity
  assertMsg "Market active-order limit reached" (length book.orders < 128)
  assertMsg "Order sequence limit reached" (book.nextOrderId < 9223372036854775807)

-- | Inputs: signed book and current market revision. Rejects changed identity,
-- terms, closed state or cutoff. No acceptance/capacity bound applies to fills.
checkTrading : OrderBook -> ContractId BinaryMarket -> Update ()
checkTrading book market = do
  current <- fetch market
  assertMsg "Market identity or terms do not match order book"
    (current.operator == book.key.operator && current.protocolName == book.key.protocolName &&
     current.marketId == book.key.marketId && current.creator == book.creator &&
     current.createdAt == book.marketCreatedAt && current.terms == book.terms)
  now <- getTime
  assertMsg "Orders require an Open market before cutoff" (current.status == Open && now < book.terms.closeAt)

-- | Inputs: a live book. Result: all <=128 fetched, indexed order projections.
-- Rejects stale references, changed market/vault/asset/factory, invalid terms or
-- altered acceptance IDs. Only selected buy backing is spent and checked later.
matchingSnapshot : OrderBook -> Update [Matching.MatchOrder]
matchingSnapshot book = mapA (\ref -> do
  current <- fetch ref.order
  assertMsg "Indexed order does not match its committed reference"
    (current.key == book.key && current.vault == book.vault && current.instrument == book.terms.collateral &&
     current.factory == book.factory && current.feeTerms.assetDecimals == book.assetDecimals && current.orderId == ref.orderId && current.outcome == ref.outcome &&
     current.side == ref.side && current.price == ref.price)
  pure Matching.MatchOrder with
    orderId = current.orderId; owner = current.owner; outcome = current.outcome
    side = current.side; price = current.price; quantity = current.quantity) book.orders

-- | Inputs: a newly created partial order. Result: successor index reference;
-- its original acceptance ID and price are retained, never reallocated.
referenceFor : ContractId LimitOrder -> Update OrderReference
referenceFor cid = do
  value <- fetch cid
  pure (OrderReference value.orderId cid value.outcome value.side value.price)

-- | Inputs: committed references and an outcome/side. Rejects a missing side;
-- result is the best-price/FIFO reference, with no caller-selected order IDs.
requireBest : [OrderReference] -> Outcome -> OrderSide -> Update OrderReference
requireBest orders outcome side = case bestOrderReference orders outcome side of
  Some ref -> pure ref
  None -> abort "Both sides are required for matching"

-- | Inputs: admitted decimal tick and candidate price. Result: exact tick
-- alignment. Decimal has 10 fractional digits, so scaling sub-unit prices by
-- 10^10 gives exact Int values below 10^10. Integer remainder avoids division
-- rounding accidentally accepting a near-tick price such as 0.4000000001.
validPrice : Decimal -> Decimal -> Bool
validPrice = Matching.validMatchPrice

-- | Inputs: pinned deployment/asset/factory, caller and account. Rejects any
-- mismatch. Result: no mutation; only a fetched signed revision can fund/refund.
checkOrderAccount : MarketKey -> Party -> CollateralInstrument -> ContractId T.TransferFactory -> Party -> ContractId AssetBalance -> Update ()
checkOrderAccount key vault instrument factory owner cid = do
  account <- fetch cid
  assertMsg "Order account owner, asset, factory or deployment does not match"
    (account.operator == key.operator && account.protocolName == key.protocolName &&
     account.vault == vault && account.owner == owner && account.instrument == instrument && account.factory == factory)

-- | Inputs: remaining quantities. Result: None when empty, otherwise one lot.
-- PositionLot validation rejects negatives; callers subtract only covered amounts.
createRemainder : MarketKey -> Party -> Party -> Int -> Int -> Update (Optional (ContractId PositionLot))
createRemainder key vault owner yes no = if yes == 0 && no == 0 then pure None else do
  cid <- create PositionLot with key; vault; owner; yes; no
  pure (Some cid)

-- | Inputs: committed references and selected outcome/side. Result: best price,
-- then lowest acceptance ID. Ledger time is informational; equal timestamps do
-- not tie priority. This helper only selects; settlement verifies the full plan.
bestOrderReference : [OrderReference] -> Outcome -> OrderSide -> Optional OrderReference
bestOrderReference references outcome side =
  case sortOn (\r -> Matching.priorityKey side r.price r.orderId)
       (filter (\r -> r.outcome == outcome && r.side == side) references) of
    [] -> None
    first :: _ -> Some first

-- | Inputs: book precision, live protocol ID and the trader-approved revision/terms.
-- Errors: stale/foreign policy or changed quote.
-- Result: the exact immutable snapshot for the new order, before any funds move.
-- Fetching the consuming protocol revision makes concurrent updates conflict.
-- It also means admin/market creation updates require a fresh protocol ID even
-- when the fee revision is unchanged; a separate policy root can remove that
-- coupling later. As with admin checks, deployment must pin the configured root.
checkFeeQuote : OrderBook -> ContractId Protocol -> Int -> Fees.FeeTerms -> Update Fees.FeeTerms
checkFeeQuote book policy expectedRevision expectedTerms = do
  current <- fetch policy
  assertMsg "Fee policy belongs to another protocol"
    (current.operator == book.key.operator && current.protocolName == book.key.protocolName)
  let actual = Fees.FeeTerms current.takerFeeBps book.assetDecimals
  assertMsg "Fee approval quote is stale or has wrong asset precision"
    (current.feeRevision == expectedRevision && expectedTerms == actual)
  pure actual

-- | Inputs: signed buy order. Result: the arithmetic view of its immutable
-- original size, current size/limit and cumulative taker history. Never rebuild
-- originalQuantity from a partial remainder: that loses the bound on past fills.
buyFeeState : LimitOrder -> Fees.BuyFeeState
buyFeeState order = Fees.BuyFeeState order.originalQuantity order.quantity order.price order.takerNotional order.paidFee

-- | Inputs: proposed signed order state. Result: whether its bounded history is
-- possible. Sellers can execute above their own limit, so their bound is filled
-- contracts times the maximum one-unit payout, not their sell limit. Buys have
-- the stricter limit-price bound enforced by buyFunding. History must respect
-- asset precision, and paidFee must equal the cumulative rounded charge.
validOrderFeeHistory : LimitOrder -> Bool
validOrderFeeHistory order =
  order.originalQuantity >= order.quantity && order.takerNotional >= 0.0 &&
  order.takerNotional <= intToDecimal (order.originalQuantity - order.quantity) &&
  Fees.cumulativeFee order.feeTerms order.takerNotional == Right order.paidFee &&
  Numeric.roundNumeric order.feeTerms.assetDecimals Numeric.RoundingDown order.takerNotional == order.takerNotional &&
  (case order.side of
    Sell -> True
    Buy -> case Fees.buyFunding order.feeTerms (buyFeeState order) of Right _ -> True; Left _ -> False)

-- | Inputs: a checked fee-helper result. Errors: propagate its validation error
-- as a transaction abort. Result: validated funding/movement; no ledger effect.
checkedFee : Either Text a -> Update a
checkedFee value = case value of Right result -> pure result; Left message -> abort message
