-- | Authorized binary market creation and lifecycle. This module does not hold
-- funds, place orders, finalize outcomes or redeem positions. Outcomia.Assets
-- handles transfers; Outcomia.Custody binds holdings to available balances.
--
-- The operator is a trust anchor, not a privileged trader: it approves creator
-- permissions and co-signs market contracts. Each creation consumes one protocol
-- revision, allocating a unique number within that configured lineage. Parallel
-- creations contend on that revision; clients must reload and retry stale IDs.
module Outcomia.Binary where

import DA.List (unique)
import qualified DA.Text as T
import Outcomia.Assets (AssetAdmission(..))
import Splice.Api.Token.TransferInstructionV2 qualified as T
import DA.Time (addRelTime, seconds)
import Outcomia.Resolution qualified as Resolution
import Outcomia.Types
import Outcomia.Validation

-- | One operator-approved protocol lineage. Discovery/services must pin its
-- operator and protocol name. The package does not enforce global uniqueness
-- against an operator deliberately creating a second root with the same name.
template Protocol
  with
    operator : Party
    protocolName : Text
    admins : [Party]
    nextMarketId : Int
    takerFeeBps : Int
    feeRevision : Int
  where
    signatory operator
    observer admins
    ensure boundedText 64 protocolName && validAdmins operator admins && nextMarketId > 0 &&
      takerFeeBps >= 0 && takerFeeBps <= 1000 && feeRevision >= 0

    -- | Inputs: replacement admin list, including the operator.
    -- Rejects: non-operator authorization, duplicates, empty/oversized lists or
    -- removal of the operator. Result: new revision preserving the ID counter.
    choice Protocol_SetAdmins : ContractId Protocol
      with replacementAdmins : [Party]
      controller operator
      do
        assertMsg "Admins must be unique, include the operator and number at most 64"
          (validAdmins operator replacementAdmins)
        create this with admins = replacementAdmins

    -- | Inputs: replacement rate in 0..1000 basis points, operator authorization.
    -- Errors: rate outside bounds, unauthorized caller or revision exhaustion.
    -- Result: a consuming successor; old approval quotes cannot use this ID.
    -- Existing orders retain their signed snapshot. New orders fund their
    -- approved fee budget; settlement collects into the market's backed pool.
    choice Protocol_SetTakerFee : ContractId Protocol
      with replacementFeeBps : Int
      controller operator
      do
        assertMsg "Taker fee must be between 0 and 1000 bps"
          (replacementFeeBps >= 0 && replacementFeeBps <= 1000)
        assertMsg "Fee revision limit reached" (feeRevision < 9223372036854775807)
        create this with takerFeeBps = replacementFeeBps; feeRevision = feeRevision + 1

    -- | Inputs: asset identity, vetted settlement precision 0..10 and exact factory.
    -- Rejects: another caller, invalid precision/asset ID or mismatched factory admin.
    -- Result: revocable admission for new transfers, not a token balance.
    -- The view comparison is a consistency check; the operator must authenticate
    -- the registry's factory contract and vetted code before approving it.
    nonconsuming choice Protocol_ApproveAsset : ContractId AssetAdmission
      with
        instrument : CollateralInstrument
        assetDecimals : Int
        factory : ContractId T.TransferFactory
      controller operator
      do
        factoryView <- exercise factory T.TransferFactory_PublicFetch with actors = [operator]
        assertMsg "Registry factory has the wrong instrument admin" (factoryView.admin == instrument.admin)
        create AssetAdmission with operator; instrument; factory; assetDecimals

    -- | Inputs: creator and immutable binary terms. The creator must authorize
    -- this choice; this protocol's signatory supplies the operator authorization.
    -- Rejects: inactive creators, invalid terms, elapsed cutoff or ID exhaustion.
    -- Result: next protocol revision and a Draft market, in the same transaction.
    choice Protocol_CreateBinary : (ContractId Protocol, ContractId BinaryMarket)
      with
        creator : Party
        terms : BinaryTerms
      controller creator
      do
        assertMsg "Creator must be an active admin" (creator `elem` admins)
        assertMsg "Market ID limit reached" (nextMarketId < 9223372036854775807)
        now <- getTime
        let problems = termsErrors creator now terms
        assertMsg (T.intercalate "; " problems) (null problems)
        next <- create this with nextMarketId = nextMarketId + 1
        market <- create BinaryMarket with
          operator
          protocolName
          marketId = nextMarketId
          creator
          terms
          createdAt = now
          status = Draft
          openedAt = None
          closeReason = None
        pure (next, market)

-- | Immutable terms plus explicit lifecycle state. Both operator and creator
-- are signatories, so a creator alone cannot bypass choices via a direct create
-- or the automatic Archive choice. Joint signatories remain trusted; this is
-- not protection against a malicious operator colluding with a creator.
template BinaryMarket
  with
    operator : Party
    protocolName : Text
    marketId : Int
    creator : Party
    terms : BinaryTerms
    createdAt : Time
    status : MarketStatus
    closeReason : Optional Text
    openedAt : Optional Time
  where
    signatory operator, creator
    observer Resolution.fallbackObservers terms
    ensure boundedText 64 protocolName && marketId > 0 &&
      null (termsErrors creator createdAt terms) &&
      (case openedAt of
        None -> status /= Open
        Some timestamp -> status /= Draft && createdAt <= timestamp && timestamp < terms.closeAt) &&
      (case (status, closeReason) of
        (Closed, Some reason) -> boundedText 500 reason
        (Closed, None) -> False
        (_, None) -> True
        (_, Some _) -> False)

    -- | Inputs: the current protocol revision for this operator/name.
    -- Rejects: other callers, revoked admin, wrong/stale protocol, non-Draft state
    -- or now >= cutoff. Result: an Open successor with exactly the same terms.
    choice Binary_Open : ContractId BinaryMarket
      with protocol : ContractId Protocol
      controller creator
      do
        checkCreator protocol operator protocolName creator
        assertMsg "Only a draft can open" (status == Draft)
        now <- getTime
        assertMsg "Trading cutoff has passed" (now < terms.closeAt)
        create this with status = Open; openedAt = Some now

    -- | Inputs: current protocol revision and a short closure reason.
    -- Rejects: other callers, revoked admin, wrong/stale protocol, non-Open state
    -- or blank/oversized reason. Result: a terminal Closed successor. This is a
    -- trading stop only: it does not pick YES/NO or move the resolution cutoff.
    choice Binary_Close : ContractId BinaryMarket
      with
        protocol : ContractId Protocol
        reason : Text
      controller creator
      do
        checkCreator protocol operator protocolName creator
        assertMsg "Only an open market can close" (status == Open)
        assertMsg "Closure reason must contain 1 to 500 characters" (boundedText 500 reason)
        create this with status = Closed; closeReason = Some reason

    -- | Inputs: live protocol, proposed YES/NO/invalid result and evidence.
    -- Errors: revoked/non-creator admin, never-opened market, early/expired
    -- primary window or malformed evidence. Result: consumes this market and
    -- creates one immutable proposal with a delayed finalization timestamp.
    -- Closing early does not move the cutoff. No tokens or positions are spent.
    choice Binary_ProposeResolution : ContractId Resolution.ResolutionProposal
      with
        protocol : ContractId Protocol
        outcome : Resolution.ResolutionOutcome
        evidence : Resolution.ResolutionEvidence
      controller creator
      do
        checkCreator protocol operator protocolName creator
        proposeResolution this creator outcome evidence

    -- | Inputs: explicitly nominated fallback, current protocol and evidence.
    -- Errors: wrong/inactive admin, absent fallback, never-opened market or time
    -- outside the agreed fallback window. Result: the same one-proposal boundary.
    -- A fallback needs no new primary signature: signed market terms already
    -- delegate this exact choice, while current admin status is still required.
    choice Binary_ProposeFallback : ContractId Resolution.ResolutionProposal
      with
        resolver : Party
        protocol : ContractId Protocol
        outcome : Resolution.ResolutionOutcome
        evidence : Resolution.ResolutionEvidence
      controller resolver
      do
        current <- fetch protocol
        assertMsg "Fallback protocol does not belong to this market"
          (current.operator == operator && current.protocolName == protocolName)
        assertMsg "Fallback resolver must be an active admin" (resolver `elem` current.admins)
        assertMsg "Only the configured fallback resolver may use this choice"
          (case terms.fallback of None -> False; Some policy -> policy.resolver == resolver)
        proposeResolution this resolver outcome evidence

    -- | Inputs: none. Rejects: other callers or non-Draft state. Result: a Closed
    -- draft marked cancelled. Removed creators can abandon unused drafts without
    -- needing admin reinstatement. This grants no rights over future user funds.
    choice Binary_CancelDraft : ContractId BinaryMarket
      controller creator
      do
        assertMsg "Only a draft can be cancelled" (status == Draft)
        create this with status = Closed; closeReason = Some "Draft cancelled"

-- | Inputs: operator and full proposed admin list. Result: whether it is valid.
-- Bound the list before duplicate checking. The operator is always an
-- admin; no separate implicit role can drift from the configured membership.
validAdmins : Party -> [Party] -> Bool
validAdmins operator admins =
  length admins <= 64 && operator `elem` admins && unique admins

-- | Inputs: live protocol ID and the market's operator, namespace and creator.
-- Rejects: archived/wrong namespace, different operator or revoked creator.
-- Result: no state change; the fetch participates in transaction conflict checks
-- so a committed revocation invalidates a stale authorization dependency.
checkCreator : ContractId Protocol -> Party -> Text -> Party -> Update ()
checkCreator protocol operator protocolName creator = do
  current <- fetch protocol
  assertMsg "Protocol does not belong to this market"
    (current.operator == operator && current.protocolName == protocolName)
  assertMsg "Creator must still be an active admin" (creator `elem` current.admins)

-- | Inputs: the consumed market's signed snapshot, authorized resolver and
-- proposed result/evidence. Errors: never opened, wrong time/resolver or invalid
-- evidence. Result: delayed proposal retaining every immutable market term.
-- openedAt is explicit: a cancelled draft cannot become resolvable merely by
-- giving its closure reason the same text as a formerly open market.
proposeResolution : BinaryMarket -> Party -> Resolution.ResolutionOutcome -> Resolution.ResolutionEvidence -> Update (ContractId Resolution.ResolutionProposal)
proposeResolution market resolver outcome evidence = do
  opened <- case market.openedAt of
    Some timestamp -> pure timestamp
    None -> abort "Only a previously opened market can propose resolution"
  now <- getTime
  assertMsg "Resolver is outside its agreed resolution window"
    (Resolution.eligibleResolver market.creator market.terms resolver now)
  let problems = Resolution.evidenceErrors evidence
  assertMsg (T.intercalate "; " problems) (null problems)
  create Resolution.ResolutionProposal with
    key = MarketKey market.operator market.protocolName market.marketId
    creator = market.creator; terms = market.terms; marketCreatedAt = market.createdAt
    openedAt = opened; proposedBy = resolver; outcome; evidence; proposedAt = now
    finalizableAt = addRelTime now (seconds market.terms.resolutionDelaySeconds)
